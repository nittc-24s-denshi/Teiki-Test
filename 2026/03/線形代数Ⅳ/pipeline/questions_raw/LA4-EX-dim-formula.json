{
  "id": "LA4-EX-dim-formula",
  "unit": "次元公式",
  "form": "calculation",
  "stem": {
    "value": "$V=\\mathbb{R}^3$，$W_1: x+y+z=0$，$W_2: 2x+3y-z=0$ について $\\dim(W_1+W_2)$ を次元公式と行列の階数の両方で求めよ。",
    "status": "original"
  },
  "answer": {
    "value": "$W_1=\\left\\langle\\begin{pmatrix}1\\\\0\\\\-1\\end{pmatrix},\\begin{pmatrix}0\\\\1\\\\-1\\end{pmatrix}\\right\\rangle$（$\\dim=2$），$W_2=\\left\\langle\\begin{pmatrix}1\\\\0\\\\2\\end{pmatrix},\\begin{pmatrix}0\\\\1\\\\3\\end{pmatrix}\\right\\rangle$（$\\dim=2$），$W_1\\cap W_2=\\left\\langle\\begin{pmatrix}4\\\\-3\\\\-1\\end{pmatrix}\\right\\rangle$（$\\dim=1$）より $\\dim(W_1+W_2)=2+2-1=3$。また $\\operatorname{rank}\\begin{pmatrix}1&0&1&0\\\\0&1&0&1\\\\-1&-1&2&3\\end{pmatrix}=3$ でも確認。",
    "status": "original"
  },
  "sources": [
    {
      "file": "RAW/note_linear_space_2026-11.pdf",
      "page": 2
    }
  ],
  "tags": [
    "次元公式",
    "例",
    "検算済"
  ],
  "corrections": [
    {
      "field": "answer.value",
      "before": "交わり基底 (4,-3,-1)",
      "after": "(4,-3,-1)（確定）",
      "reason": "x+y+z=0 と 2x+3y-z=0 より z=-x-y、代入で x+3y+(-x-y) 等を解くと方向ベクトル (4,-3,-1)。検算: 4-3-1=0、8-9-(-1)=0。"
    }
  ]
}
